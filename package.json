{
  "name": "local-llmup",
  "version": "0.1.0",
  "description": "Hardware-aware CLI to recommend, install, serve, and migrate memory between local LLMs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "llmup": "dist/cli.js",
    "local-llmup": "dist/cli.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "systeminformation": "^5.33.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.0"
  }
}
